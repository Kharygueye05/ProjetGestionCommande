@{
    ViewData["Title"] = "Connexion";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<style>
    .auth-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 0;
    }
    
    .auth-card {
        background-color: #ffffff;
        border-radius: 40px;
        box-shadow: 0px 4px 20px 0px rgba(0, 0, 0, 0.1);
        padding: 3rem;
        max-width: 500px;
        width: 100%;
    }
    
    .auth-title {
        font-family: 'Geist', sans-serif;
        font-weight: 900;
        font-size: 2.5rem;
        color: #111827;
        text-align: center;
        margin-bottom: 0.5rem;
    }
    
    .auth-subtitle {
        text-align: center;
        color: #6b7280;
        margin-bottom: 2rem;
    }
    
    .form-label-custom {
        font-weight: 600;
        color: #111827;
        margin-bottom: 0.5rem;
    }
    
    .form-input-custom {
        border: 2px solid #e5e7eb;
        border-radius: 15px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        width: 100%;
        transition: border-color 0.2s;
    }
    
    .form-input-custom:focus {
        border-color: #ffd700;
        outline: none;
    }
    
    .submit-btn {
        background-color: #e6c200;
        border: none;
        border-radius: 30px;
        padding: 0.75rem 0;
        width: 100%;
        font-size: 1.125rem;
        font-weight: 600;
        color: #000000;
        cursor: pointer;
        margin-top: 1.5rem;
        transition: transform 0.2s;
    }
    
    .submit-btn:hover {
        transform: scale(1.02);
    }
    
    .error-message {
        background-color: #fee2e2;
        border: 1px solid #ef4444;
        border-radius: 10px;
        padding: 0.75rem;
        color: #dc2626;
        margin-bottom: 1.5rem;
        text-align: center;
    }
    
    .switch-link {
        text-align: center;
        margin-top: 1.5rem;
        color: #6b7280;
    }
    
    .switch-link a {
        color: #e6c200;
        text-decoration: none;
        font-weight: 600;
    }
    
    .switch-link a:hover {
        text-decoration: underline;
    }
</style>

<div class="container auth-container">
    <div class="auth-card">
        <h1 class="auth-title">Connexion</h1>
        <p class="auth-subtitle">Connectez-vous pour continuer</p>
        
        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }
        
        <form method="post" asp-action="Login" asp-controller="Auth">
            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }
            
            <div class="mb-3">
                <label class="form-label-custom">Numéro de téléphone</label>
                <input type="tel" name="telephone" class="form-input-custom" placeholder="77 123 45 67" required>
            </div>
            
            <div class="mb-3">
                <label class="form-label-custom">Mot de passe</label>
                <input type="password" name="password" class="form-input-custom" placeholder="••••••••" required>
            </div>
            
            <button type="submit" class="submit-btn">Se connecter</button>
        </form>
        
        <div class="switch-link">
            Pas encore de compte ? 
            <a href="@Url.Action("Register", "Auth", new { returnUrl = returnUrl })">Créer un compte</a>
        </div>
    </div>
</div>