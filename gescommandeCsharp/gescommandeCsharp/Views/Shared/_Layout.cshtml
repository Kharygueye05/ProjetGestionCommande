<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Brasil Burger</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Geist:wght@600;900&display=swap" rel="stylesheet">
    <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            margin: 0;
            padding: 0;
        }
        
        /* Navbar */
        .navbar-custom {
            background-color: rgba(0, 0, 0, 0.9);
            padding: 2rem 0;
        }
        
        .nav-link-custom {
            color: #ffffff;
            font-size: 1.5rem;
            font-weight: 500;
            margin: 0 2rem;
            text-decoration: none;
        }
        
        .nav-link-custom:hover {
            color: #ffd700;
        }
        
        .btn-connexion {
            border: 1px solid #e5e7eb;
            border-radius: 30px;
            color: #ffffff;
            padding: 0.5rem 1.5rem;
            font-size: 1.5rem;
            font-weight: 500;
            text-decoration: none;
        }
        
        .btn-connexion:hover {
            background-color: #ffd700;
            color: #000000;
            border-color: #ffd700;
        }
        
        /* Badge panier */
        .cart-icon-wrapper {
            position: relative;
            display: inline-block;
        }
        
        .cart-badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: #e6c200;
            color: #000000;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
        }
        
        /* Footer */
        .footer-custom {
            background-color: rgba(0, 0, 0, 0.9);
            color: rgba(255, 255, 255, 0.94);
            padding: 3rem 2rem;
            border-top-left-radius: 40px;
            border-top-right-radius: 40px;
            margin-top: 4rem;
        }
        
        .footer-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }
        
        .footer-link {
            color: rgba(255, 255, 255, 0.94);
            text-decoration: none;
            display: block;
            margin-bottom: 0.75rem;
            font-size: 1.25rem;
        }
        
        .footer-link:hover {
            color: #ffd700;
        }
        
        .social-icon {
            width: 32px;
            height: 32px;
            border: 1px solid #ffffff;
            background-color: transparent;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            border-radius: 50%;
        }
        
        .copyright-divider {
            border-top: 1px solid rgba(255, 255, 255, 0.27);
            margin: 2rem 0 1.5rem;
        }
    </style>
</head>
<body>
    <nav class="navbar-custom">
        <div class="container-fluid px-5">
            <div class="row w-100 align-items-center">
                <div class="col-3">
                    <img src="~/images/logo.png" alt="Brasil Burger Logo" style="height: 104px; width: 215px;" onerror="this.style.display='none'">
                </div>
                <div class="col-6 text-center">
                    <a href="@Url.Action("Index", "Catalogue")" class="nav-link-custom">Catalogue</a>
                    @if (Context.Session.GetInt32("ClientId").HasValue)
                    {
                        <a href="@Url.Action("MesCommandes", "Commande")" class="nav-link-custom">Mes Commandes</a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Auth", new { returnUrl = Url.Action("MesCommandes", "Commande") })" class="nav-link-custom">Mes Commandes</a>
                    }
                </div>
                <div class="col-3 text-end">
                    <a href="@Url.Action("Index", "Panier")" class="me-3 cart-icon-wrapper" style="text-decoration: none;">
                        <span class="iconify" data-icon="simple-line-icons:basket" style="color: white; font-size: 30px;"></span>
                        <span class="cart-badge" id="cartBadge">0</span>
                    </a>
                    @if (Context.Session.GetInt32("ClientId").HasValue)
                    {
                        <a href="@Url.Action("Logout", "Auth")" class="btn btn-connexion">Déconnexion</a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Auth")" class="btn btn-connexion">Connexion</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer-custom">
        <div class="container">
            <div class="row">
                <div class="col-12 col-md-4 mb-4">
                    <img src="~/images/logo-blanc.png" alt="Brasil Burger Logo" style="height: 180px; width: 304px;" class="mb-3" onerror="this.style.display='none'">
                    <p style="font-size: 1.25rem;">Livraison rapide partout à Dakar</p>
                </div>

                <div class="col-12 col-md-4 mb-4">
                    <h4 class="footer-title">Navigation rapide</h4>
                    <a href="@Url.Action("Index", "Catalogue")" class="footer-link">Catalogue</a>
                    <a href="#" class="footer-link">Mes Commandes</a>
                    <a href="#" class="footer-link">Connexion</a>
                </div>

                <div class="col-12 col-md-4 mb-4">
                    <h4 class="footer-title">Contactez-Nous</h4>
                    <p class="footer-link mb-2">+221 78 128 45 45</p>
                    <p class="footer-link mb-2">+221 77 737 01 01</p>
                    <p class="footer-link mb-3">Villa 5b, Av.Birago Diop</p>
                    
                    <div class="d-flex mt-3">
                        <a href="#" class="social-icon">
                            <span class="iconify" data-icon="ic:baseline-facebook" style="color: white; font-size: 24px;"></span>
                        </a>
                        <a href="#" class="social-icon">
                            <span class="iconify" data-icon="mdi:instagram" style="color: white; font-size: 24px;"></span>
                        </a>
                        <a href="#" class="social-icon">
                            <span class="iconify" data-icon="iconoir:tiktok" style="color: white; font-size: 24px;"></span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="copyright-divider"></div>

            <div class="row">
                <div class="col-12 text-center">
                    <p style="font-size: 1.25rem; margin: 0;">@DateTime.Now.Year Brasil Burger. Tout droits réservés.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function updateCartBadge() {
            let cart = JSON.parse(localStorage.getItem('brasilBurgerCart') || '[]');
            let totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            
            const badge = document.getElementById('cartBadge');
            if (badge) {
                badge.textContent = totalItems;
                badge.style.display = totalItems > 0 ? 'inline-block' : 'none';
            }
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            updateCartBadge();
        });
    </script>
</body>
</html>