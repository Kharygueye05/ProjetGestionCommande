{% extends 'base.html.twig' %}

{% block title %}Commande #{{ commande.id }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Commande #{{ commande.id }}</h1>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Informations</h5>
                <table class="table">
                    <tr>
                        <th>ID:</th>
                        <td>{{ commande.id }}</td>
                    </tr>
                    <tr>
                        <th>Date:</th>
                        <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                    </tr>
                    <tr>
                        <th>Client:</th>
                        <td>
                            {% if commande.client %}
                                {{ commande.client.getNom() }} {{ commande.client.getPrenom() }}
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Type:</th>
                        <td>
                            <span class="badge 
                                {% if commande.typeCommande == 'sur_place' %}bg-info
                                {% elseif commande.typeCommande == 'a_emporter' %}bg-warning
                                {% else %}bg-success{% endif %}">
                                {{ commande.typeCommande|replace({'_': ' '})|title }}
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>État:</th>
                        <td>
                            <span class="badge 
                                {% if commande.etat == 'reçue' %}bg-primary
                                {% elseif commande.etat == 'preparation' %}bg-warning
                                {% elseif commande.etat == 'terminee' %}bg-success
                                {% else %}bg-danger{% endif %}">
                                {{ commande.etat|title }}
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Montant:</th>
                        <td>{{ commande.montant }} FCFA</td>
                    </tr>
                </table>

                {# Boutons pour changer l'état #}
                <div class="mt-3">
                    {% if commande.etat == 'reçue' %}
                        <form method="post" action="{{ path('app_commande_etat_preparation', {'id': commande.id}) }}" 
                              class="d-inline">
                            <button type="submit" class="btn btn-warning" 
                                    onclick="return confirm('Mettre en préparation ?')">
                                <i class="bi bi-hourglass-split"></i> Mettre en préparation
                            </button>
                        </form>
                    {% endif %}

                    {% if commande.etat == 'preparation' %}
                        <form method="post" action="{{ path('app_commande_etat_terminee', {'id': commande.id}) }}" 
                              class="d-inline">
                            <button type="submit" class="btn btn-success" 
                                    onclick="return confirm('Marquer comme terminée ?')">
                                <i class="bi bi-check-circle"></i> Marquer comme terminée
                            </button>
                        </form>
                    {% endif %}

                    {% if commande.etat not in ['annulee', 'terminee'] %}
                        <form method="post" action="{{ path('app_commande_etat_annulee', {'id': commande.id}) }}" 
                              class="d-inline">
                            <button type="submit" class="btn btn-danger" 
                                    onclick="return confirm('Annuler cette commande ?')">
                                <i class="bi bi-x-circle"></i> Annuler la commande
                            </button>
                        </form>
                    {% endif %}

                    {% if commande.etat == 'annulee' %}
                        <form method="post" action="{{ path('app_commande_etat_recue', {'id': commande.id}) }}" 
                              class="d-inline">
                            <button type="submit" class="btn btn-secondary" 
                                    onclick="return confirm('Réactiver cette commande ?')">
                                <i class="bi bi-arrow-clockwise"></i> Réactiver la commande
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a href="{{ path('app_commande_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
            <a href="{{ path('app_commande_edit', {'id': commande.id}) }}" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Éditer
            </a>
        </div>
    </div>
{% endblock %}