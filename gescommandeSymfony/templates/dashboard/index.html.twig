{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block stylesheets %}
<style>
    .stats-cards {
        display: flex;
        gap: 21px;
        margin-bottom: 50px;
        flex-wrap: wrap;
    }
    
    .stat-card {
        background-color: white;
        border-radius: 15px;
        box-shadow: 0px 4px 8px 0px rgba(0,0,0,0.25);
        width: 201px;
        height: 171px;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;

    }
    
    .stat-header {
        background-color: #111827;
        height: 62px;
        width: 100%;
        border-radius: 15px 15px 0 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        position: relative;
    }
    
    .stat-header-text {
        font-size: 15px;
        font-weight: 500;
        color: white;
    }
    
    .stat-header iconify-icon {
        font-size: 24px;
        color: white;
    }
    
    .stat-value {
        font-family: 'Geist', sans-serif;
        font-size: 24px;
        font-weight: 700;
        color: #1F2937;
        margin-top: 17px;
    }
    
    .stat-label {
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        font-weight: 500;
        color: #323C47;
        margin-top: 17px;
    }
    
    .section-title {
        font-family: 'Geist', sans-serif;
        font-size: 24px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 30px;
    }
    
    .products-card {
        background-color: white;
        border-radius: 15px;
        box-shadow: 0px 4px 8px 0px rgba(0,0,0,0.25);
        padding: 40px;
        margin-bottom: 30px;
    }
    
    .product-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }
    
    .product-item:last-child {
        margin-bottom: 0;
    }
    
    .product-name {
        font-family: 'Manrope', sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: black;
        max-width: 60%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    
    .product-sales {
        font-family: 'Manrope', sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: black;
    }
    
    .progress-bar-container {
        width: 100%;
        height: 8px;
        background-color: #E5E7EB;
        border-radius: 30px;
        margin-top: 10px;
        overflow: hidden;
    }
    
    .progress-bar-fill {
        height: 100%;
        background-color: #FFD700;
        border-radius: 30px;
    }
    
    .orders-card {
        background-color: white;
        border-radius: 15px;
        box-shadow: 0px 4px 8px 0px rgba(0,0,0,0.25);
        padding: 40px;
        position: relative;
    }
    
    .order-item {
        background-color: white;
        border-radius: 8px;
        padding: 15px 19px;
        margin-bottom: 13px;
        position: relative;
        border: 1px solid #E5E7EB;
    }
    
    .order-item:last-child {
        margin-bottom: 0;
    }
    
    .order-title {
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: black;
    }
    
    .order-client {
        font-family: 'Manrope', sans-serif;
        font-size: 11px;
        font-weight: 500;
        color: rgba(0,0,0,0.94);
        margin-top: 8px;
    }
    
    .order-product {
        font-family: 'Manrope', sans-serif;
        font-size: 11px;
        font-weight: 500;
        color: rgba(31,41,55,0.74);
        margin-top: 5px;
    }
    
    .order-price {
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: black;
        position: absolute;
        right: 100px;
        top: 20px;
    }
    
    .order-status {
        position: absolute;
        right: 19px;
        top: 20px;
        padding: 5px 10px;
        border-radius: 20px;
        font-family: 'Manrope', sans-serif;
        font-size: 10px;
        font-weight: 500;
    }
    
    .status-received {
        background-color: rgba(0, 255, 94, 0.13);
        color: rgba(0, 255, 94, 0.63);
    }
    
    .status-cancelled {
        background-color: rgba(255, 49, 49, 0.22);
        color: rgba(255, 49, 49, 0.63);
    }
    
    .status-completed {
        background-color: rgba(205, 86, 154, 0.13);
        color: rgba(205, 86, 154, 0.63);
    }
    
    .cta-banner {
        background-color: #E6C200;
        border-radius: 15px;
        padding: 50px;
        text-align: center;
        margin-top: 50px;
        margin-bottom: 30px;
    }
    
    .cta-title {
        font-family: 'Geist', sans-serif;
        font-size: 36px;
        font-weight: 900;
        color: #111827;
        margin-bottom: 15px;
    }
    
    .cta-subtitle {
        font-family: 'Manrope', sans-serif;
        font-size: 16px;
        font-weight: 500;
        color: #111827;
        margin-bottom: 30px;
    }
    
    .cta-buttons {
        display: flex;
        justify-content: center;
        gap: 28px;
        flex-wrap: wrap;
    }
    
    .cta-btn {
        background-color: white;
        color: black;
        border: none;
        border-radius: 30px;
        padding: 10px 20px;
        font-size: 20px;
        font-weight: 500;
        font-family: 'Poppins', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        transition: background-color 0.3s;
    }
    
    .cta-btn:hover {
        background-color: #f8f8f8;
        color: black;
    }
    
    .cta-btn iconify-icon {
        font-size: 24px;
    }
    
    .voir-tout {
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        color: #FFD700;
        text-decoration: none;
        position: absolute;
        right: 40px;
        top: 40px;
    }
    
    .voir-tout:hover {
        color: #E6C200;
    }
    
    @media (max-width: 992px) {
        .stats-cards {
            justify-content: center;
        }
        
        .cta-buttons {
            flex-direction: column;
            align-items: center;
        }
        
        .order-price {
            right: 80px;
        }
    }
</style>
{% endblock %}

{% block body %}
   
        <header class="page-header">
            <h1 class="page-title">Tableau de bord</h1>
            <p class="page-subtitle">Vue d'ensemble de votre activité du jour</p>
        </header>
        
        <!-- Stats Cards -->
        <div class="stats-cards">
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-header-text">Commandes</span>
                    <iconify-icon icon="material-symbols:orders-rounded"></iconify-icon>
                </div>
                <div class="stat-value">{{ commandesEnCours }}</div>
                <div class="stat-label">En cours</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-header-text">Commandes</span>
                    <iconify-icon icon="lets-icons:check-fill"></iconify-icon>
                </div>
                <div class="stat-value">{{ commandesValidees }}</div>
                <div class="stat-label">Validées</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-header-text">Commandes</span>
                    <iconify-icon icon="mage:tag-cross-fill"></iconify-icon>
                </div>
                <div class="stat-value">{{ commandesAnnulees }}</div>
                <div class="stat-label">Annulées</div>
            </div>
            
            <!-- Recettes -->
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-header-text">Recettes</span>
                    <iconify-icon icon="si:money-fill"></iconify-icon>
                </div>
                <div class="stat-value">{{ recettesJournalieres|number_format(0, ',', ' ') }} FCFA</div>
                <div class="stat-label">Journalières</div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="products-card">
                    <h2 class="section-title">Produits les plus vendus</h2>
                    
                    {% for produit in topProduits %}
                    <div class="product-item">
                        <div class="w-100">
                            <div class="d-flex justify-content-between">
                                <span class="product-name">{{ produit.nom }}</span>
                                <span class="product-sales">{{ produit.quantite_vendue }} ventes</span>
                            </div>
                            <div class="progress-bar-container">
                                <div class="progress-bar-fill" style="width: {{ produit.pourcentage|round }}%;"></div>
                            </div>
                        </div>
                    </div>
                    {% else %}
                    <div class="product-item">
                        <div class="w-100">
                            <div class="d-flex justify-content-between">
                                <span class="product-name">Aucune vente aujourd'hui</span>
                                <span class="product-sales">0 vente</span>
                            </div>
                            <div class="progress-bar-container">
                                <div class="progress-bar-fill" style="width: 0%;"></div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                    
                </div>
            </div>
            
            <div class="col-md-6 mb-4">
                <div class="orders-card">
                    <h2 class="section-title">Commandes récentes</h2>
                    <a href="{{ path('app_commande_index') }}" class="voir-tout">Voir tout</a>
                    
                    {% for commande in commandesRecentes %}
                    <div class="order-item">
                        <div class="order-title">Commande n°{{ commande.id }}</div>
                        <div class="order-client">{{ commande.client.user.prenom }} {{ commande.client.user.nom }}</div>
                        <div class="order-product">
                            {% for ligne in commande.ligneCommandes|slice(0, 2) %}
                                {{ ligne.produitNom }} x{{ ligne.quantite }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                            {% if commande.ligneCommandes|length > 2 %}...{% endif %}
                        </div>
                        <div class="order-price">{{ commande.montant|number_format(0, ',', ' ') }} FCFA</div>
                        <span class="order-status 
                            {% if commande.etat == 'reçue' %}status-received
                            {% elseif commande.etat == 'annulee' %}status-cancelled
                            {% elseif commande.etat == 'terminee' %}status-completed
                            {% else %}status-received{% endif %}">
                            {{ commande.etat|title }}
                        </span>
                    </div>
                    {% else %}
                    <div class="order-item">
                        <div class="order-title">Aucune commande récente</div>
                    </div>
                    {% endfor %}
                    
                </div>
            </div>
        </div>
        
        <div class="cta-banner">
            <h2 class="cta-title">Gérez votre restaurant efficacement</h2>
            <p class="cta-subtitle">Accédez rapidement à certaines fonctionnalités de gestion</p>
            <div class="cta-buttons">
                <a href="#" class="cta-btn">
                    <iconify-icon icon="mdi:delivery-dining-outline"></iconify-icon>
                    <span>Gérez les livraisons</span>
                </a>
                <a href="{{ path('app_commande_index') }}" class="cta-btn">
                    <iconify-icon icon="lets-icons:order"></iconify-icon>
                    <span>Voir les commandes</span>
                </a>
            </div>
        </div>
   
{% endblock %}