<div class="section-header">
    <h2 class="section-title">Zones de Livraison</h2>
    <button class="add-zone-btn" disabled title="Fonctionnalité disponible en Java">
        <span>+</span>
        <span>Ajouter une Zone</span>
    </button>
</div>

{% if zones|length > 0 %}
<div class="zones-grid">
    {% for zone in zones %}
    <div class="zone-card">
        <h3 class="zone-name">{{ zone.nomZone }}</h3>
        <div class="zone-neighborhoods">
            {% for quartier in zone.quartiers|slice(0, 3) %}
                <span class="neighborhood-badge">{{ quartier }}</span>
            {% endfor %}
            {% if zone.quartiers|length > 3 %}
                <span class="neighborhood-badge">+{{ zone.quartiers|length - 3 }}</span>
            {% endif %}
        </div>
        <div class="zone-price">{{ zone.prixLivraison|number_format(0, ',', ' ') }} FCFA</div>
        <div class="zone-price-label">Prix de livraison</div>
        <div class="zone-actions">
            <button class="zone-btn btn-modifier" disabled title="Fonctionnalité disponible en Java">
                <iconify-icon icon="system-uicons:write"></iconify-icon>
                <span>Modifier</span>
            </button>
            <button class="zone-btn btn-supprimer" disabled title="Fonctionnalité disponible en Java">
                <iconify-icon icon="ic:baseline-delete"></iconify-icon>
                <span>Supprimer</span>
            </button>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<div class="empty-state">
    <iconify-icon icon="mingcute:location-line" width="64" height="64"></iconify-icon>
    <div class="empty-state-title">Aucune zone de livraison</div>
</div>
{% endif %}

<style>
.zones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(282px, 1fr));
    gap: 30px;
}

.zone-card {
    background-color: white;
    border-radius: 15px;
    box-shadow: 0px 4px 8px 0px rgba(0,0,0,0.25);
    padding: 20px;
    height: 213px; /* Hauteur exacte Figma */
    position: relative;
}

.zone-name {
    font-family: 'Geist', sans-serif;
    font-size: 17px;
    font-weight: 900;
    color: #111827;
    margin-bottom: 15px;
}

.zone-neighborhoods {
    display: flex;
    gap: 11px; /* Espacement exact Figma */
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.neighborhood-badge {
    background-color: #E5E7EB;
    color: #111827;
    padding: 5px 10px;
    border-radius: 20px;
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    font-weight: 500;
}

.zone-price {
    font-family: 'Geist', sans-serif;
    font-size: 20px;
    font-weight: 900;
    color: #FFD700; /* Jaune Figma */
    margin-bottom: 5px;
}

.zone-price-label {
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: #111827;
    margin-bottom: 25px;
}

.zone-actions {
    display: flex;
    gap: 23px; /* Espacement exact Figma */
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
}

.zone-btn {
    flex: 1;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'Poppins', sans-serif;
    cursor: not-allowed;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    opacity: 0.6;
}

.zone-btn iconify-icon {
    font-size: 16px;
}

.btn-modifier {
    background-color: #E5E7EB;
    color: black;
}

.btn-supprimer {
    background-color: rgba(255, 0, 0, 0.13);
    color: rgba(255, 0, 0, 0.64);
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
    background-color: #F9FAFB;
    border-radius: 15px;
}

.empty-state iconify-icon {
    font-size: 64px;
    color: #D1D5DB;
    margin-bottom: 20px;
}

.empty-state-title {
    font-family: 'Geist', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #6B7280;
    margin-bottom: 10px;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.section-title {
    font-family: 'Geist', sans-serif;
    font-size: 24px;
    font-weight: 900;
    color: #111827;
    margin: 0;
}

.add-zone-btn {
    background-color: #FFD700; /* Jaune Figma */
    color: #111827; /* Noir Figma */
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 700;
    font-family: 'Poppins', sans-serif;
    cursor: not-allowed;
    display: flex;
    align-items: center;
    gap: 5px;
    opacity: 0.6;
}
</style>