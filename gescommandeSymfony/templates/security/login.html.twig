{% extends 'security/base_login.html.twig' %}
{% block title %}Connexion - Brasil Burger{% endblock %}

{% block stylesheets %}
    .login-card {
        background-color: #111827 !important;
        border-radius: 40px;
        box-shadow: 0px 4px 4px 0px rgba(0,0,0,0.25);
        padding: 60px 70px;
        width: 100%;
        max-width: 514px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 35px;
    }
    
    .login-logo {
        width: 295px;
        height: 128px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .login-title {
        font-family: 'Poppins', sans-serif;
        font-size: 24px;
        font-weight: 700;
        color: #FFD700;
        text-align: center;
        margin: 0;
    }
    
    .input-container {
        width: 100%;
        max-width: 353px;
        position: relative;
    }
    
    .login-input {
        width: 100%;
        height: 45.33px;
        background-color: #F1F1F1;
        border: 1px solid #DDD;
        border-radius: 30px;
        padding: 12px 20px 12px 50px;
        font-family: 'Poppins', sans-serif;
        font-size: 13.3px;
        color: #333;
        transition: all 0.3s;
    }
    
    .login-input::placeholder {
        color: #767676;
    }
    
    .login-input:focus {
        outline: none;
        border-color: #FFD700;
        background-color: white;
        box-shadow: 0 0 0 2px rgba(255, 215, 0, 0.1);
    }
    
    .input-icon {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: #FFD700;
        font-size: 16px;
    }
    
    .login-btn {
        background-color: #FFD700 !important;
        color: black;
        border: none;
        border-radius: 30px;
        padding: 12px 24px;
        width: 100%;
        max-width: 230px;
        height: 43px;
        font-family: 'Poppins', sans-serif;
        font-size: 16px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.3s;
        margin-top: 10px;
    }
    
    .login-btn:hover {
        background-color: #E6C200 !important;
    }
    
    @media (max-width: 768px) {
        .login-card {
            padding: 40px 30px;
            border-radius: 30px;
            gap: 30px;
        }
        
        .login-logo {
            width: 160px;
            height: 100px;
        }
        
        .input-container {
            max-width: 100%;
        }
    }
    
    @media (max-width: 480px) {
        .login-card {
            padding: 30px 20px;
            border-radius: 20px;
        }
        
        .login-title {
            font-size: 20px;
        }
    }
{% endblock %}

{% block body %}
    <div class="login-card">
        <div class="login-logo">
            <img src="{{ asset('images/logo.png') }}" alt="Brasil Burger Logo" style="max-width: 100%; height: auto;">
        </div>
        
        <h1 class="login-title">Connexion</h1>
        
        <form method="post">
            {% if error %}
                <div class="alert alert-danger mb-3 py-2 px-3" style="border-radius: 8px; font-size: 14px;">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}
            
            <div class="input-container mb-4">
                <iconify-icon icon="mdi:email" class="input-icon"></iconify-icon>
                <input type="email" 
                       value="{{ last_username }}" 
                       name="email" 
                       id="inputEmail" 
                       class="login-input" 
                       placeholder="Email" 
                       required 
                       autofocus>
            </div>
            
            <div class="input-container mb-4">
                <iconify-icon icon="mdi:lock" class="input-icon"></iconify-icon>
                <input type="password" 
                       name="password" 
                       id="inputPassword" 
                       class="login-input" 
                       placeholder="Mot de passe" 
                       required>
            </div>
            
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            
            <button class="login-btn" type="submit">Se connecter</button>
        </form>
    </div>
{% endblock %}