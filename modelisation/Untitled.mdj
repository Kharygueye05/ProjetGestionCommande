							"width": 592,
							"height": 1489,
							"text": "CREATE DATABASE IF NOT EXISTS GestionCommande;\nUSE GestionCommande;\n\nCREATE TABLE User (\n    id_user INT AUTO_INCREMENT PRIMARY KEY,\n    nom VARCHAR(50) NOT NULL,\n    prenom VARCHAR(50) NOT NULL,\n    telephone VARCHAR(20) NOT NULL\n);\n\nCREATE TABLE Client (\n    id_client INT PRIMARY KEY,\n    adresse TEXT NOT NULL,\n    email VARCHAR(100) UNIQUE NOT NULL,\n    password VARCHAR(255) NOT NULL,\n    FOREIGN KEY (id_client) REFERENCES User(id_user) ON DELETE CASCADE\n);\n\nCREATE TABLE Gestionnaire (\n    id_gestionnaire INT PRIMARY KEY,\n    email VARCHAR(100) UNIQUE NOT NULL,\n    password VARCHAR(255) NOT NULL,\n    FOREIGN KEY (id_gestionnaire) REFERENCES User(id_user) ON DELETE CASCADE\n);\n\nCREATE TABLE Livreur (\n    id_livreur INT PRIMARY KEY,\n    FOREIGN KEY (id_livreur) REFERENCES User(id_user) ON DELETE CASCADE\n);\n\n\nCREATE TABLE Produit (\n    id_produit INT AUTO_INCREMENT PRIMARY KEY,\n    nom VARCHAR(100) NOT NULL,\n    image VARCHAR(255),\n    archive BOOLEAN DEFAULT FALSE\n);\n\nCREATE TABLE Burger (\n    id_burger INT PRIMARY KEY,\n    prix INT NOT NULL,\n    FOREIGN KEY (id_burger) REFERENCES Produit(id_produit) ON DELETE CASCADE\n);\n\nCREATE TABLE Complement (\n    id_complement INT PRIMARY KEY,\n    prix INT NOT NULL,\n    type VARCHAR(20) NOT NULL CHECK (type IN ('boisson', 'frites')),\n    FOREIGN KEY (id_complement) REFERENCES Produit(id_produit) ON DELETE CASCADE\n);\n\nCREATE TABLE Menu (\n    id_menu INT PRIMARY KEY,\n    id_burger INT NOT NULL,\n    id_complement_boisson INT NOT NULL,\n    id_complement_frites INT NOT NULL,\n    FOREIGN KEY (id_menu) REFERENCES Produit(id_produit) ON DELETE CASCADE,\n    FOREIGN KEY (id_burger) REFERENCES Burger(id_burger),\n    FOREIGN KEY (id_complement_boisson) REFERENCES Complement(id_complement),\n    FOREIGN KEY (id_complement_frites) REFERENCES Complement(id_complement),\n    CHECK (id_complement_boisson != id_complement_frites)\n);\n\n\nCREATE TABLE Zone (\n    id_zone INT AUTO_INCREMENT PRIMARY KEY,\n    nom_zone VARCHAR(100) NOT NULL,\n    prix_livraison INT NOT NULL,\n    quartiers TEXT NOT NULL\n);\n\n\n\nCREATE TABLE Commande (\n    id_commande INT AUTO_INCREMENT PRIMARY KEY,\n    date_commande DATETIME DEFAULT CURRENT_TIMESTAMP,\n    type_commande VARCHAR(20) NOT NULL CHECK (type_commande IN ('sur place', 'à emporter', 'livraison')),\n    etat VARCHAR(20) DEFAULT 'en cours' CHECK (etat IN ('reçue', 'validée', 'terminée', 'annulée')),\n    montant_total INT NOT NULL,\n    id_client INT NOT NULL,\n    id_livreur INT NULL,\n    id_zone INT NULL,\n    FOREIGN KEY (id_client) REFERENCES Client(id_client),\n    FOREIGN KEY (id_livreur) REFERENCES Livreur(id_livreur),\n    FOREIGN KEY (id_zone) REFERENCES Zone(id_zone),\n    CHECK (\n        (type_commande = 'livraison' AND id_zone IS NOT NULL) OR\n        (type_commande != 'livraison' AND id_zone IS NULL)\n    )\n);\n\nCREATE TABLE LigneCommande (\n    id_ligne INT AUTO_INCREMENT PRIMARY KEY,\n    quantite INT NOT NULL CHECK(quantite > 0),\n    prix_unitaire INT NOT NULL,\n    id_commande INT NOT NULL,\n    id_produit INT NOT NULL,\n    FOREIGN KEY (id_commande) REFERENCES Commande(id_commande) ON DELETE CASCADE,\n    FOREIGN KEY (id_produit) REFERENCES Produit(id_produit)\n);\n\nCREATE TABLE Paiement (\n    id_paiement INT AUTO_INCREMENT PRIMARY KEY,\n    date_paiement DATETIME DEFAULT CURRENT_TIMESTAMP,\n    montant INT NOT NULL,\n    mode_paiement VARCHAR(20) NOT NULL CHECK (mode_paiement IN ('Wave', 'OM')),\n    id_commande INT UNIQUE NOT NULL,\n    FOREIGN KEY (id_commande) REFERENCES Commande(id_commande) ON DELETE CASCADE\n);"
						}
					]
				},
